# 로컬·사내 PC 에서 돌릴 때 쓰는 설정 파일 예시.
# 이 파일을 복사해 `.env` 로 만들고 값을 채우세요. `.env` 는 git 에 올라가지 않습니다.
#
#   cp .env.example .env
#
# 값에 따옴표는 필요 없습니다.

# 공공데이터포털 일반 인증키 (Encoding/Decoding 어느 쪽이든 됩니다)
G2B_SERVICE_KEY=

# Notion 내부 인테그레이션 토큰 (ntn_ 또는 secret_ 로 시작)
NOTION_TOKEN=

# 적재 대상 Notion 데이터베이스 ID (32자리 hex)
NOTION_DATABASE_ID=
